<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Readability limits for code that agents read one file at a time. Formatting is not here: google-java-format
  (Spotless) owns it. Every rule is an error, and the build fails on any violation (maxWarnings is 0).
  Generated code under build/generated is skipped by the Gradle task, not by a suppression file.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <!-- Counts every line, blank and comment lines included, so a long file splits instead of hiding lines. -->
  <module name="FileLength">
    <property name="max" value="300"/>
  </module>

  <module name="TreeWalker">
    <!-- Empty lines and comments are not counted: a documented 30-line method is still a short method. -->
    <module name="MethodLength">
      <property name="max" value="30"/>
      <property name="countEmpty" value="false"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="4"/>
      <property name="ignoreOverriddenMethods" value="true"/>
    </module>
    <!-- Checkstyle counts nesting beyond the first level, so 1 allows two nested blocks, as AGENTS.md asks. -->
    <module name="NestedIfDepth">
      <property name="max" value="1"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="1"/>
    </module>
    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>

    <!--
      Names that say nothing. An agent reaches for `result` or `data` when it has not decided what the value
      is, and a specific name is what makes `rg` find the definition and its uses.
    -->
    <module name="LocalVariableName">
      <property name="format" value="^(?!(result|data|info|item|tmp|temp|obj|val)$)[a-z][a-zA-Z0-9]*$"/>
      <property name="allowOneCharVarInForLoop" value="true"/>
    </module>
    <module name="LocalFinalVariableName">
      <property name="format" value="^(?!(result|data|info|item|tmp|temp|obj|val)$)[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^(?!(result|data|info|item|tmp|temp|obj|val)$)[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="LambdaParameterName">
      <property name="format" value="^(?!(result|data|info|item|tmp|temp|obj|val)$)[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="PatternVariableName">
      <property name="format" value="^(?!(result|data|info|item|tmp|temp|obj|val)$)[a-z][a-zA-Z0-9]*$"/>
    </module>

    <module name="AvoidStarImport"/>

    <!-- Belt and braces: PMD and Error Prone also report these, but a line check names the exact place. -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="\bSystem\.(out|err)\."/>
      <property name="message" value="System.out and System.err are not allowed; log through SLF4J."/>
    </module>
    <module name="RegexpSinglelineJava">
      <property name="format" value="\.printStackTrace\s*\("/>
      <property name="message" value="printStackTrace is not allowed; log the exception or rethrow it with context."/>
    </module>

    <!-- The public API of main code gets a sentence of intent; tests set javadocScope to nothing. -->
    <module name="MissingJavadocType">
      <property name="scope" value="${javadocScope}"/>
    </module>
  </module>
</module>
