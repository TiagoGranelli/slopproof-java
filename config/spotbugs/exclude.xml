<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs skips generated code only: the openapi-generator interfaces and DTOs (api) and the jOOQ tables
  (db). Hand-written code in these packages is not exempt by package; move it out if it needs the check.
-->
<FindBugsFilter>
  <Match>
    <Package name="~com\.example\.slopproof\.api(\..*)?"/>
  </Match>
  <Match>
    <Package name="~com\.example\.slopproof\.db(\..*)?"/>
  </Match>
</FindBugsFilter>
