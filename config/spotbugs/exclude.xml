<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs skips generated code only: the openapi-generator interfaces and DTOs (api) and the jOOQ tables
  (db). The match is by package, so hand-written code placed in these packages would be exempt too: never put any there.
-->
<FindBugsFilter>
  <Match>
    <Package name="~com\.example\.slopproof\.api(\..*)?"/>
  </Match>
  <Match>
    <Package name="~com\.example\.slopproof\.db(\..*)?"/>
  </Match>
</FindBugsFilter>
